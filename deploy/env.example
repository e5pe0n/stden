# Template for /opt/stden/.env on the mini PC. Create it there with mode 600.
# This file is a template only — never commit real values.

# Rewritten by each deploy to sha-<commit>. Set a specific tag to roll back.
IMAGE_TAG=latest

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Must use the same password as POSTGRES_PASSWORD. Host `db` is the compose
# service name.
DATABASE_URL=postgresql://stden:CHANGE_ME@db:5432/stden

# From Google AI Studio. Set a hard request cap on the key there — it is the
# only thing bounding cost if anything ever reaches this endpoint unexpectedly.
GOOGLE_GEN_AI_API_KEY=
